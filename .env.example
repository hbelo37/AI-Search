# Copy to .env for local runs (`node --env-file=.env server/src/index.js`). On Railway, set these under Variables.
ANTHROPIC_API_KEY=            # required unless MOCK_LLM=1 — set it yourself in Railway; never commit it
APP_PASSCODE=                 # shared team passcode; leave empty only for local use
MODEL_QUICK=claude-haiku-5-5      # suggestions (prompt + filter)
MODEL_DEFAULT=claude-sonnet-5-5   # interpreter, "default" tier
MODEL_COMPLEX=claude-opus-5-5     # interpreter, "complex" tier
TEMPERATURE=0                 # keep 0 so benchmark runs are comparable
RATE_LIMIT_PER_MIN=60
ALLOWED_ORIGINS=              # only if the browser calls Railway directly (API_BASE_URL); not needed with the Netlify proxy
MOCK_LLM=                     # 1 = canned answers, no API calls (UI/QC walkthroughs)
SERVE_WEB=                    # 0 = API only (when Netlify hosts the frontend)
